{
  "expo": {
    "name": "Pellicule",
    "slug": "phototri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f3ef"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phototri.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dfe8d2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.phototri.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Pellicule a besoin d'accéder à tes photos pour t'aider à les trier.",
          "savePhotosPermission": "Pellicule a besoin d'enregistrer des photos dans ta photothèque.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4c7a2b"
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
              "./node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
              "./node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/outfit/700Bold/Outfit_700Bold.ttf",
              "./node_modules/@expo-google-fonts/outfit/800ExtraBold/Outfit_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/outfit/900Black/Outfit_900Black.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Outfit",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/outfit/700Bold/Outfit_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/outfit/800ExtraBold/Outfit_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/outfit/900Black/Outfit_900Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9505ec18-08e3-4669-8002-a4992177bd04"
      }
    },
    "owner": "augustindevasselot"
  }
}
