{
  "expo": {
    "name": "Pellicule",
    "slug": "phototri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f5f7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phototri.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pellicule a besoin d'accéder à tes photos pour t'aider à les trier (garder, supprimer, imprimer).",
        "NSPhotoLibraryAddUsageDescription": "Pellicule a besoin d'enregistrer des photos améliorées dans ta photothèque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.phototri.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Pellicule a besoin d'accéder à tes photos pour t'aider à les trier.",
          "savePhotosPermission": "Pellicule a besoin d'enregistrer des photos dans ta photothèque.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Pellicule n'utilise pas le tracking publicitaire — cette autorisation reste désactivée par défaut."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2e4d7a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9505ec18-08e3-4669-8002-a4992177bd04"
      }
    },
    "owner": "augustindevasselot"
  }
}
