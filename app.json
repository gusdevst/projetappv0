{
  "expo": {
    "name": "phototri",
    "slug": "phototri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phototri.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Phototri a besoin d'accéder à tes photos pour t'aider à les trier (garder, supprimer, imprimer).",
        "NSPhotoLibraryAddUsageDescription": "Phototri a besoin d'enregistrer des photos améliorées dans ta photothèque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.phototri.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Phototri a besoin d'accéder à tes photos pour t'aider à les trier.",
          "savePhotosPermission": "Phototri a besoin d'enregistrer des photos dans ta photothèque.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
